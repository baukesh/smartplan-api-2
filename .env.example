SECRET_KEY=change-me
API_ACCESS_KEY=change-me-api-key
API_ACCESS_KEY_HEADER=X-API-Key
DATABASE_URL=sqlite+aiosqlite:///./smartplan.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_PREFIX=/api/v1
PROJECT_NAME=Smart Plan API

# CORS defaults already allow localhost dev ports (3000, 5173).
# You can override with a JSON array string, e.g.:
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0)(:\\d+)?$
BACKEND_CORS_ALLOW_ALL=false
